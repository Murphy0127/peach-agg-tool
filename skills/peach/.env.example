# Copy this file to ~/.config/peach-agg-tool/.env and fill in your credentials:
#   mkdir -p ~/.config/peach-agg-tool
#   cp .env.example ~/.config/peach-agg-tool/.env

# OKX API Credentials (benchmark --agg okx/all and legacy BSC commands)
# Get credentials from: https://www.okx.com/account/my-api
OKX_API_KEY=""
OKX_SECRET_KEY=""
OKX_PASSPHRASE=""
OKX_PROJECT_ID=""
# Optional region: global / eea / us (Project ID is optional for benchmark)
OKX_REGION="global"

# Optional Kyber credentials. Without a Key, benchmark uses the public API.
KYBER_API_KEY=""
KYBER_CLIENT_ID="peach-agg-tool"

# Optional Fly credentials (ARC mainnet). Without a Key, uses api.fly.trade.
FLY_API_KEY=""
FLY_NETWORK="arc"

# Peach Debug API Token (for debug command pool inspection)
PEACH_DEBUG_TOKEN=""
