{
  "name": "peach-agg-tool",
  "version": "0.6.0",
  "description": "ARC/BSC aggregator quote comparison, execution simulation and evidence-based analysis",
  "type": "module",
  "bin": {
    "peach-agg-tool": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "data",
    "skills",
    "!skills/peach/.env",
    ".claude-plugin",
    "docs"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:benchmark": "node --import tsx --test test/benchmark.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@masterpeach/aggregator-sdk": "0.3.0",
    "@peachprojects/aggregator-sdk": "^0.0.0-experimental-20260601084259",
    "ethers": "^6.0.0",
    "undici": "^7.24.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Murphy0127/peach-agg-tool.git"
  },
  "homepage": "https://github.com/Murphy0127/peach-agg-tool#readme"
}
